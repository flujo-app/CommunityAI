FROM ghcr.io/astral-sh/uv:0.11.21@sha256:6f1fa8fc4040ad7197d7e652057219871e5f6640abfe2b790f1419fdb2319e6b AS uv

FROM python:3.12.13-slim-bookworm@sha256:6e13e65c55e33adf203d77ee371cf8bf5d81bd4902ef07565721f46bf44917af

ARG SOURCE_COMMIT
ARG SOURCE_TREE_DIGEST
ARG DOCKERFILE_DIGEST
ARG LOCKFILE_DIGEST

LABEL org.opencontainers.image.title="CommunityAI discovery seed" \
      org.opencontainers.image.source="https://github.com/flujo-app/CommunityAI" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.base.name="python:3.12.13-slim-bookworm" \
      communityai.discovery.source-tree="${SOURCE_TREE_DIGEST}" \
      communityai.discovery.dockerfile="${DOCKERFILE_DIGEST}" \
      communityai.discovery.lockfile="${LOCKFILE_DIGEST}" \
      communityai.discovery.runtime="hivemind-dht-only"

ENV HOME=/tmp/communityai \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy \
    UV_TORCH_BACKEND=cpu \
    COMMUNITYAI_SOURCE_COMMIT=${SOURCE_COMMIT}

COPY --from=uv /uv /bin/uv
COPY deploy/discovery/requirements.lock /opt/communityai/requirements.lock

RUN test -n "${SOURCE_COMMIT}" \
    && test -n "${SOURCE_TREE_DIGEST}" \
    && test -n "${DOCKERFILE_DIGEST}" \
    && test -n "${LOCKFILE_DIGEST}" \
    && uv pip install --system --require-hashes --no-deps --torch-backend cpu \
         --requirements /opt/communityai/requirements.lock \
    && python -c "import hivemind; assert hivemind.__version__ == '1.1.12'" \
    && mkdir -p /data /run/communityai /tmp/communityai \
    && chown 65532:65532 /run/communityai /tmp/communityai \
    && chmod 0700 /run/communityai /tmp/communityai

COPY deploy/gcp/bootstrap_node.py /opt/communityai/bootstrap_node.py
COPY deploy/discovery/entrypoint.py /opt/communityai/entrypoint.py

EXPOSE 31337/tcp
VOLUME ["/data"]
STOPSIGNAL SIGTERM

# The entrypoint must begin as root solely to prepare a newly attached volume. It
# drops supplementary groups, gid, and uid to 65532 before starting Hivemind.
ENTRYPOINT ["python", "-u", "/opt/communityai/entrypoint.py"]
