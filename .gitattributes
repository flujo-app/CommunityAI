# Shell scripts and Dockerfiles run on Unix (and via `curl ... | sh`); they must be
# checked out with LF regardless of the platform they were committed from, or the
# shell chokes on the stray CR (e.g. `set -eu\r` -> "set: -: invalid option").
*.sh          text eol=lf
Dockerfile    text eol=lf

# Several inherited Python blobs use CRLF or mixed historical endings. Treat the CR as
# part of the line ending while still rejecting actual trailing spaces and tabs.
*.py          whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# PowerShell / batch are Windows-native; keep CRLF.
*.ps1         text eol=crlf
*.bat         text eol=crlf
