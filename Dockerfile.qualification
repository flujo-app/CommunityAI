# syntax=docker/dockerfile:1.7

FROM ghcr.io/astral-sh/uv:0.11.21@sha256:6f1fa8fc4040ad7197d7e652057219871e5f6640abfe2b790f1419fdb2319e6b AS uv

FROM python:3.12.13-slim-bookworm@sha256:6e13e65c55e33adf203d77ee371cf8bf5d81bd4902ef07565721f46bf44917af

ARG SOURCE_COMMIT
ARG CANDIDATE
ARG MANIFEST_DIGEST
ARG DECLARED_ARTIFACT_BYTES
ARG SOURCE_TREE_DIGEST
ARG DOCKERFILE_DIGEST

LABEL org.opencontainers.image.title="CommunityAI qualification runtime" \
      org.opencontainers.image.source="https://github.com/flujo-app/CommunityAI" \
      org.opencontainers.image.revision="${SOURCE_COMMIT}" \
      org.opencontainers.image.base.name="python:3.12.13-slim-bookworm" \
      communityai.qualification.candidate="${CANDIDATE}" \
      communityai.qualification.manifest="${MANIFEST_DIGEST}" \
      communityai.qualification.artifact-bytes="${DECLARED_ARTIFACT_BYTES}" \
      communityai.qualification.source-tree="${SOURCE_TREE_DIGEST}" \
      communityai.qualification.dockerfile="${DOCKERFILE_DIGEST}"

ENV PATH=/workspace/.venv/bin:${PATH} \
    HOME=/tmp/communityai \
    HF_HOME=/cache/huggingface \
    DRIFT_CACHE=/cache \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    UV_NO_CACHE=1 \
    UV_LINK_MODE=copy \
    PYTHONDONTWRITEBYTECODE=1 \
    COMMUNITYAI_QUALIFICATION_SOURCE_COMMIT=${SOURCE_COMMIT} \
    COMMUNITYAI_QUALIFICATION_CANDIDATE=${CANDIDATE} \
    COMMUNITYAI_QUALIFICATION_MANIFEST=/workspace/qualification/model-manifest.json \
    COMMUNITYAI_QUALIFICATION_CACHE_DIR=/cache/model

COPY --from=uv /uv /uvx /bin/

WORKDIR /workspace
COPY Dockerfile.qualification pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts/fly_qualification_node.py scripts/qualification_image_contract.py ./scripts/
COPY . /qualification-source

RUN test -n "${SOURCE_COMMIT}" \
    && test -n "${CANDIDATE}" \
    && test -n "${MANIFEST_DIGEST}" \
    && test -n "${DECLARED_ARTIFACT_BYTES}" \
    && test -n "${SOURCE_TREE_DIGEST}" \
    && test -n "${DOCKERFILE_DIGEST}" \
    && apt-get update \
    && apt-get install --no-install-recommends -y build-essential \
    && uv sync --frozen --no-dev --no-editable --python /usr/local/bin/python \
    && apt-get purge --auto-remove -y build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /workspace/qualification /cache/model /tmp/communityai \
    && chown -R 65532:65532 /tmp/communityai

COPY --from=contract image-contract.json /workspace/qualification/image-contract.json
COPY --from=contract model-manifest.json /workspace/qualification/model-manifest.json
COPY --from=snapshot --chown=65532:65532 . /cache/model

RUN python scripts/qualification_image_contract.py verify \
      --contract /workspace/qualification/image-contract.json \
      --manifest /workspace/qualification/model-manifest.json \
      --snapshot-root /cache/model \
      --source-tree-root /qualification-source \
      --source-commit "${SOURCE_COMMIT}" \
      --candidate "${CANDIDATE}" \
      --manifest-digest "${MANIFEST_DIGEST}" \
      --declared-artifact-bytes "${DECLARED_ARTIFACT_BYTES}" \
      --source-tree-digest "${SOURCE_TREE_DIGEST}" \
      --dockerfile-digest "${DOCKERFILE_DIGEST}" \
    && python -c 'from importlib.metadata import version; from drift import __version__; raise SystemExit(0 if __version__ == version("drift") else 1)' \
    && rm -rf /qualification-source

USER 65532:65532

ENTRYPOINT ["python", "-u", "/workspace/scripts/fly_qualification_node.py"]
